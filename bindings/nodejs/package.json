{
    "name": "fastlowess",
    "version": "3.0.0",
    "description": "High-performance LOWESS smoothing for Node.js",
    "main": "index.js",
    "types": "index.d.ts",
    "bin": {
        "fastlowess-install-gpu": "./bin/install-gpu.js"
    },
    "scripts": {
        "build": "napi build --release",
        "build:debug": "napi build",
        "test": "node --test tests/test_fastlowess.js",
        "lint": "oxlint index.js tests/test_fastlowess.js",
        "universal": "napi universal",
        "snippets": "node ../../dev/add-nodejs-outputs.js",
        "docs": "npm run snippets && typedoc && astro build",
        "docs:preview": "astro preview"
    },
    "napi": {
        "binaryName": "fastlowess",
        "targets": [
            "x86_64-unknown-linux-gnu",
            "aarch64-unknown-linux-gnu",
            "x86_64-unknown-linux-musl",
            "x86_64-pc-windows-msvc",
            "aarch64-pc-windows-msvc",
            "x86_64-apple-darwin",
            "aarch64-apple-darwin"
        ]
    },
    "optionalDependencies": {
        "fastlowess-darwin-arm64": "^3.0.0",
        "fastlowess-darwin-x64": "^3.0.0",
        "fastlowess-linux-arm64-gnu": "^3.0.0",
        "fastlowess-linux-x64-gnu": "^3.0.0",
        "fastlowess-linux-x64-musl": "^3.0.0",
        "fastlowess-win32-arm64-msvc": "^3.0.0",
        "fastlowess-win32-x64-msvc": "^3.0.0"
    },
    "devDependencies": {
        "@napi-rs/cli": "^3.8",
        "oxlint": "^1.80",
        "typedoc": "^0.28",
        "typedoc-plugin-markdown": "^4.12",
        "@astrojs/starlight": "^0.41",
        "astro": "^7.2"
    },
    "engines": {
        "node": ">= 20"
    },
    "license": "MIT OR Apache-2.0"
}