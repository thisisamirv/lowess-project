TARGET_DIR = ./target

# R-Universe sets CARGO_BUILD_TARGET for cross-compilation (e.g. aarch64-pc-windows-gnullvm)
RUST_TARGET := $(if $(CARGO_BUILD_TARGET),$(CARGO_BUILD_TARGET),x86_64-pc-windows-gnu)
LIBDIR = $(TARGET_DIR)/$(RUST_TARGET)/release
STATLIB = $(LIBDIR)/librfastlowess.a

# GNU-style linking for MinGW
# --allow-multiple-definition works around duplicate raw-dylib Windows API
# import stubs pulled in by --whole-archive when the GPU (wgpu) dependency
# tree is enabled (multiple crates emit their own stub object for the same
# kernel32/oleaut32/etc. symbol).
# On gnullvm (arm64), skip --whole-archive entirely: it forces every crate's
# private raw-dylib stub for a given DLL into the link even when they cover
# different, non-overlapping symbols of that DLL (e.g. std's stub provides
# WaitOnAddress/WakeByAddressAll, once_cell's provides WakeByAddressSingle).
# ld.lld's arm64pe backend can't reliably tolerate the resulting duplicates
# (crashes or drops symbols), so let normal single-definition-per-symbol
# archive resolution apply instead -- entrypoint.c already references the
# extendr init symbol directly, so nothing needed from the archive is lost.
ifneq ($(findstring gnullvm,$(RUST_TARGET)),)
WHOLE_ARCHIVE_LIBS = -lrfastlowess
else
WHOLE_ARCHIVE_LIBS = -Wl,--whole-archive -lrfastlowess -Wl,--no-whole-archive
endif
PKG_LIBS = -L$(LIBDIR) $(WHOLE_ARCHIVE_LIBS) -Wl,--allow-multiple-definition -lws2_32 -luserenv -ladvapi32 -lbcrypt -lncrypt -lntdll -Wl,--export-all-symbols -Wl,--strip-all

# Set WITH_GPU=1 in the environment (e.g. R CMD INSTALL invocation) to build
# with the GPU execution backend enabled (requires the vendored fastLowess
# archive to still have its wgpu deps, i.e. it was created with WITH_GPU=1
# during vendoring).
CARGO_FEATURES =
ifeq ($(WITH_GPU),1)
CARGO_FEATURES = --features gpu
endif

all: clean $(SHLIB)

$(SHLIB): $(STATLIB)

$(STATLIB):
	@cargo --version
	@rustc --version
	@# Extract vendored dependencies if archive exists and vendor dir doesn't
	@if [ -f vendor.tar.xz ] && [ ! -d vendor ]; then \
		echo "Extending vendor.tar.xz..."; \
		$(TAR) -xf vendor.tar.xz; \
	fi
	@# Create .cargo/config.toml from non-hidden source (avoids R CMD check NOTE)
	@mkdir -p .cargo
	@cp cargo-config.toml .cargo/config.toml
	@mkdir -p $(TARGET_DIR)
	@cargo build -q -j 2 --release --manifest-path=Cargo.toml --target-dir $(TARGET_DIR) --target $(RUST_TARGET) $(CARGO_FEATURES)
	@# lld 19 rejects .idata$4 relocations in raw-dylib stubs (rustc<=1.97, gnullvm)
	@# ar x (no member arg) resolves long-name entries; ar/objcopy are in PATH with nm
	@if echo "$(RUST_TARGET)" | grep -q gnullvm; then \
		_lib=$$(pwd)/$(STATLIB); \
		mkdir -p _ar_patch; \
		(cd _ar_patch || exit 0; \
			ar x "$$_lib" 2>/dev/null; \
			for _dll in *.dll; do \
				[ -f "$$_dll" ] && { \
					objcopy --remove-section='.idata$$4' "$$_dll" 2>/dev/null || true; \
					ar r "$$_lib" "$$_dll" 2>/dev/null; \
				}; \
			done); \
		rm -rf _ar_patch; \
	fi
	@rm -rf .cargo

clean:
	rm -Rf $(SHLIB) $(STATLIB) $(OBJECTS)
