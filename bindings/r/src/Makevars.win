TARGET_DIR = ./target

# R-Universe sets CARGO_BUILD_TARGET for cross-compilation (e.g. aarch64-pc-windows-gnullvm)
RUST_TARGET := $(if $(CARGO_BUILD_TARGET),$(CARGO_BUILD_TARGET),x86_64-pc-windows-gnu)
LIBDIR = $(TARGET_DIR)/$(RUST_TARGET)/release
STATLIB = $(LIBDIR)/librfastlowess.a

# GNU-style linking for MinGW
# --allow-multiple-definition works around duplicate raw-dylib Windows API
# import stubs pulled in by --whole-archive when the GPU (wgpu) dependency
# tree is enabled (multiple crates emit their own stub object for the same
# kernel32/oleaut32/etc. symbol).
PKG_LIBS = -L$(LIBDIR) -Wl,--whole-archive -lrfastlowess -Wl,--no-whole-archive -Wl,--allow-multiple-definition -lws2_32 -luserenv -ladvapi32 -lbcrypt -lncrypt -lntdll -Wl,--export-all-symbols -Wl,--strip-all

# Set WITH_GPU=1 in the environment (e.g. R CMD INSTALL invocation) to build
# with the GPU execution backend enabled (requires the vendored fastLowess
# archive to still have its wgpu deps, i.e. it was created with WITH_GPU=1
# during vendoring).
CARGO_FEATURES =
ifeq ($(WITH_GPU),1)
CARGO_FEATURES = --features gpu
endif

all: clean $(SHLIB)

$(SHLIB): $(STATLIB)

$(STATLIB):
	@cargo --version
	@rustc --version
	@# Extract vendored dependencies if archive exists and vendor dir doesn't
	@if [ -f vendor.tar.xz ] && [ ! -d vendor ]; then \
		echo "Extending vendor.tar.xz..."; \
		$(TAR) -xf vendor.tar.xz; \
	fi
	@# Create .cargo/config.toml from non-hidden source (avoids R CMD check NOTE)
	@mkdir -p .cargo
	@cp cargo-config.toml .cargo/config.toml
	@mkdir -p $(TARGET_DIR)
	@cargo build -q -j 2 --release --manifest-path=Cargo.toml --target-dir $(TARGET_DIR) --target $(RUST_TARGET) $(CARGO_FEATURES)
	@# lld 19 rejects .idata$4 in raw-dylib stubs on gnullvm; patch each *.dll member in-place
	@if echo "$(RUST_TARGET)" | grep -q gnullvm; then \
		for _obj in $$(llvm-ar t $(STATLIB) | grep -i '\.dll$$'); do \
			llvm-ar x $(STATLIB) "$$_obj" 2>/dev/null && \
			llvm-objcopy --remove-section='.idata$$4' "$$_obj" 2>/dev/null && \
			llvm-ar r $(STATLIB) "$$_obj" && \
			rm -f "$$_obj" || true; \
		done; \
	fi
	@rm -rf .cargo

clean:
	rm -Rf $(SHLIB) $(STATLIB) $(OBJECTS)
