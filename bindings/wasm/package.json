{
    "name": "fastlowess-wasm",
    "version": "3.2.0",
    "description": "WASM bindings for fastlowess",
    "scripts": {
        "lint": "oxlint src tests",
        "snippets": "python3 ../../dev/verify_snippets.py --lang wasm --timeout 120 --update-outputs",
        "readme": "python3 ../../dev/add-readme-to-docs.py",
        "docs": "npm run snippets && npm run readme && typedoc && node ../../dev/lowercase-typedoc-refs.js src/content/docs/reference && astro build",
        "docs:preview": "astro preview"
    },
    "devDependencies": {
        "@astrojs/markdown-remark": "^7.3",
        "@astrojs/starlight": "^0.41",
        "astro": "^7.2",
        "katex": "^0.18",
        "oxlint": "^1.80",
        "rehype-katex": "^7.0",
        "remark-math": "^6.0",
        "typedoc": "^0.28",
        "typedoc-plugin-markdown": "^4.13"
    },
    "license": "MIT OR Apache-2.0"
}